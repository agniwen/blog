{
  "name": "@agniwen/blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:remote": "BLOG_D1_REMOTE=1 vite dev --port 3000",
    "build": "vite build --mode cloudflare",
    "start": "vite preview --port 3000",
    "lint": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "check": "oxlint --fix && oxfmt --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply blog --remote --config .void-wrangler.jsonc",
    "auth:generate": "void prepare && bunx auth@1.7.4 generate --config scripts/auth.config.ts",
    "typecheck": "void prepare && tsc --noEmit",
    "test": "bun test",
    "build:cloudflare": "vite build --mode cloudflare",
    "preview:cloudflare": "vite preview --mode cloudflare",
    "deploy": "bun run build && wrangler deploy --config dist/ssr/wrangler.json",
    "cf:typegen": "bun run build && wrangler types src/worker-env.d.ts --config dist/ssr/wrangler.json --env-file docs/env.example",
    "cf:secrets": "bun scripts/cloudflare-secrets.mjs",
    "test:loading": "bun test tests/pending-indicator.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply blog --local --config .void-wrangler.jsonc --persist-to .void",
    "test:auth": "bun test tests/auth-client-origin.test.mjs",
    "test:domains": "bun test tests/canonical-redirect.test.mjs",
    "test:http": "bun test tests/http.test.mjs",
    "prepare": "void prepare",
    "env:check": "void env check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "1.7.4",
    "@floating-ui/react": "^0.27.20",
    "@iconify/react": "^6.0.2",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-horizontal-rule": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@void/react": "1.3.0",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "1.0.0-rc.4",
    "foxact": "^0.2.55",
    "hono": "^4.13.7",
    "html-react-parser": "^6.1.7",
    "htmlparser2": "^12.0.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^0.511.0",
    "motion": "^12.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hotkeys-hook": "^5.3.3",
    "spotify-url-info": "^3.3.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.82.0",
    "postcss-nested": "^7.0.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "void": "1.3.0",
    "wrangler": "4.151.0"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.21.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "workerd"
  ]
}
