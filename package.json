{
  "name": "@agniwen/blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build --mode cloudflare",
    "start": "vite preview --port 3000",
    "lint": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "check": "oxlint --fix && oxfmt --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply blog --remote",
    "auth:generate": "bunx auth@1.7.4 generate --config scripts/auth.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:cloudflare": "vite build --mode cloudflare",
    "preview:cloudflare": "vite preview --mode cloudflare",
    "deploy": "bun scripts/deploy-cloudflare.mjs",
    "cf:typegen": "wrangler types src/worker-env.d.ts --env-file .env.example",
    "cf:secrets": "bun scripts/cloudflare-secrets.mjs",
    "test:loading": "bun test tests/pending-indicator.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply blog --local",
    "test:auth": "bun test tests/auth-client-origin.test.mjs",
    "test:domains": "bun test tests/canonical-redirect.test.mjs",
    "test:http": "bun test tests/http.test.mjs"
  },
