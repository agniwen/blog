{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxfmt-config/refs/heads/main/v1.schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "quoteProps": "as-needed",
  "sortImports": {
    "internalPattern": ["~/"],
    "sortSideEffects": false
  },
  "sortTailwindcss": {
    "functions": ["cn", "cva", "clsx"],
    "stylesheet": "./src/styles/app.css"
  },
  "ignorePatterns": [
    "dist/**",
    "src/generated/**",
    "src/worker-env.d.ts",
    ".wrangler/**",
    ".void/**",
    ".void-wrangler.jsonc"
  ]
}
