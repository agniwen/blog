{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxfmt-config/refs/heads/main/v1.schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "quoteProps": "as-needed",
  "sortImports": {
    "internalPattern": ["~/"],
    "sortSideEffects": false
  },
  "sortTailwindcss": {
    "functions": ["cn", "cva", "clsx"],
    "stylesheet": "./src/app/globals.css"
  },
  "ignorePatterns": ["dist/**", ".output/**", ".next/**", "src/generated/**"]
}
